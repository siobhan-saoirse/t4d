"VertexlitGeneric"
{
	"$baseTexture" "models/player/items/pyro/pyro_rocks_mask"

	

	//"$yellow" "0"
	"$one" "1"

	"$phong" "1"
	"$phongexponent" "20"
	"$phongboost" ".8"	
	"$lightwarptexture" "models/player/pyro/pyro_lightwarp"
	"$phongfresnelranges"	"[.3 1 8]"
	"$halflambert" "0"

 	"$blendtintbybasealpha" "1" 
	"$blendtintcoloroverbase" "1"  

	"$colortint_base" "{140 22 22}"
