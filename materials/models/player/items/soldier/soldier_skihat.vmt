"VertexlitGeneric"
{
	"$baseTexture" "models/player/items/soldier/soldier_skihat"
	"$bumpmap" "models/player/items/soldier/soldier_skihat_normal" 
	
	"$phong" "1"
	"$phongexponent" "10"
	"$phongboost" "4"
	"$lightwarptexture" "models/lightwarps/weapon_lightwarp"	
	"$phongfresnelranges"	"[.25 .5 1]"


	"$blendtintbybasealpha" "1"
	"$colortint_base" "{72 64 58}"
	"$colortint_tmp" "[0 0 0]"	
